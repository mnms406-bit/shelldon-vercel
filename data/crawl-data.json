      "id": "gid://shopify/Page/113288904868",
      "title": "News Today",
      "handle": "news-today",
      "body": "<meta charset=\"UTF-8\"> <meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\">\n<h1><select id=\"newsChannels\" onchange=\"showNews()\">\n<option value=\"\">Select a channel</option>\n<option value=\"https://time.com/\">Time</option>\n<option value=\"https://edition.cnn.com/\">CNN</option>\n<option value=\"https://www.reuters.com/\">Reuters</option>\n<option value=\"https://www.aljazeera.com/\">Al Jazeera</option>\n<!-- Add more channels as needed --></select></h1>\n<div id=\"newsContainer\"></div>\n<script>\nfunction showNews() {\n  var dropdown = document.getElementById(\"newsChannels\");\n  var selectedChannel = dropdown.options[dropdown.selectedIndex].value;\n  var newsContainer = document.getElementById(\"newsContainer\");\n\n  if (selectedChannel) {\n    newsContainer.innerHTML = '<iframe src=\"' + selectedChannel + '\" width=\"100%\" height=\"600px\"></iframe>';\n  } else {\n    newsContainer.innerHTML = '';\n  }\n}\n</script>"
