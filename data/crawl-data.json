      "id": "gid://shopify/Page/152483659940",
      "title": "Industry Updates",
      "handle": "industry-updates",
      "body": "<div id=\"industry-updates\" style=\"font-family: Arial, sans-serif; margin: 20px 0;\">\n  <h2 style=\"font-size: 28px; margin-bottom: 20px;\">Click below to see more:</h2>\n  <div id=\"news-container\" style=\"display: flex; flex-wrap: wrap; gap: 20px;\"></div>\n  <button id=\"loadMoreBtn\" style=\"margin-top: 20px; padding: 10px 20px; font-size: 14px; border:none; border-radius:5px; background-color:#1a0dab; color:white; cursor:pointer;\">Load More Updates</button>\n</div>\n\n<script>\nconst allArticles = [\n  // General e-commerce\n  {\n    title: \"E-commerce Resale Market Growth\",\n    description: \"The resale market grew 21% YoY, driven by sustainable fashion trends…\",\n    link: \"https://www.retaildive.com/\",\n    source: \"Retail Dive\",\n    date: \"11/18/2025\"\n  },\n  {\n    title: \"Shipping & Supply Chain Challenges\",\n    description: \"Supply chain delays continue to impact online retailers, highlighting the need for better inventory planning…\",\n    link: \"https://www.ecommercebytes.com/\",\n    source: \"eCommerceBytes\",\n    date: \"11/17/2025\"\n  },\n  {\n    title: \"AI Tools Transforming E-commerce\",\n    description: \"Artificial intelligence is helping online stores optimize pricing, marketing, and customer service…\",\n    link: \"https://www.practicalecommerce.com/\",\n    source: \"Practical Ecommerce\",\n    date: \"11/16/2025\"\n  },\n  {\n    title: \"Mobile Shopping Trends 2025\",\n    description: \"Mobile commerce continues to dominate, with smartphones now accounting for more than half of online transactions…\",\n    link: \"https://www.bigcommerce.com/blog/ecommerce-news/\",\n    source: \"BigCommerce Blog\",\n    date: \"11/15/2025\"\n  },\n  {\n    title: \"Sustainability in Online Retail\",\n    description: \"More consumers are prioritizing eco-friendly products and secondhand marketplaces, reshaping the online retail landscape…\",\n    link: \"https://www.iovista.com/ecommerce-blog/\",\n    source: \"ioVista Ecommerce Blog\",\n    date: \"11/14/2025\"\n  },\n  {\n    title: \"Optimizing Shipping & Fulfillment\",\n    description: \"Efficient logistics remain key for online store success, with faster delivery increasing customer retention…\",\n    link: \"https://www.ithinklogistics.com/\",\n    source: \"iThinkLogistics\",\n    date: \"11/13/2025\"\n  },\n\n  // Tariff / Dropshipping updates\n  {\n    title: \"How Tariffs Impact E-commerce Sellers\",\n    description: \"Recent tariffs are affecting online marketplaces and Amazon sellers; strategies are needed to maintain profit margins…\",\n    link: \"https://www.helium10.com/blog/impact-of-tariffs-on-ecommerce-sellers/\",\n    source: \"Helium 10\",\n    date: \"11/18/2025\"\n  },\n  {\n    title: \"US Import Duty Rule Changes\",\n    description: \"The $800 de minimis exemption ended; import duties now apply to smaller shipments, impacting dropshipping margins…\",\n    link: \"https://www.easyship.com/blog/impact-of-new-us-import-duty-rules\",\n    source: \"Easyship\",\n    date: \"11/17/2025\"\n  },\n  {\n    title: \"New Tariffs & Dropshipping\",\n    description: \"Dropshippers face higher import costs due to new tariffs; planning and alternative sourcing strategies are essential…\",\n    link: \"https://www.zendrop.com/blog/understanding-the-new-tariffs/\",\n    source: \"Zendrop\",\n    date: \"11/16/2025\"\n  },\n  {\n    title: \"Dropshipping Tariffs from China\",\n    description: \"New import duties affect dropshippers sourcing from China; compliance and margin strategies are key…\",\n    link: \"https://supliful.com/blog/dropshipping-tariffs-and-taxes-to-import-from-china\",\n    source: \"Supliful\",\n    date: \"11/15/2025\"\n  },\n  {\n    title: \"Ecommerce Tariffs: What’s Changing & How to Adapt\",\n    description: \"Analysis on tariffs, de minimis removal, and other trade changes reshaping small-to-mid ecommerce businesses…\",\n    link: \"https://trueprofit.io/blog/ecommerce-tariffs\",\n    source: \"TrueProfit.io\",\n    date: \"11/14/2025\"\n  },\n  {\n    title: \"Optimizing Product Feeds & Checkout to Offset Tariff Volatility\",\n    description: \"Advice on changing your checkout and product feed to account for landed costs and import duties…\",\n    link: \"https://www.graypoplar.com/posts/optimizing-product-feeds-and-checkout-experience-to-offset-tariff-and-shipping-volatility?utm_source=chatgpt.com\",\n    source: \"GrayPoplar\",\n    date: \"11/13/2025\"\n  },\n  {\n    title: \"Avoid New Tariffs with Low-Duty Fulfillment\",\n    description: \"Strategies for avoiding high duty by using different fulfillment methods for dropshipping…\",\n    link: \"https://www.graypoplar.com/posts/avoid-new-tariffs-with-one-piece-dropshipping-and-low-duty-fulfillment?utm_source=chatgpt.com\",\n    source: \"GrayPoplar\",\n    date: \"11/12/2025\"\n  }\n];\n\nlet displayedCount = 0;\nconst increment = 6; // number of cards to show initially and each load\nconst newsContainer = document.getElementById('news-container');\nconst loadMoreBtn = document.getElementById('loadMoreBtn');\n\nfunction renderArticles() {\n  const nextArticles = allArticles.slice(displayedCount, displayedCount + increment);\n  nextArticles.forEach(item => {\n    const card = document.createElement('div');\n    card.style.flex = '1 1 300px';\n    card.style.border = '1px solid #ddd';\n    card.style.borderRadius = '10px';\n    card.style.padding = '15px';\n    card.style.boxShadow = '0 2px 6px rgba(0,0,0,0.1)';\n    card.style.backgroundColor = '#fff';\n    card.style.transition = 'transform 0.2s, box-shadow 0.2s';\n    card.onmouseover = () => { card.style.transform='translateY(-3px)'; card.style.boxShadow='0 5px 15px rgba(0,0,0,0.2)'; };\n    card.onmouseout = () => { card.style.transform='translateY(0)'; card.style.boxShadow='0 2px 6px rgba(0,0,0,0.1)'; };\n\n    card.innerHTML = `\n      <a href=\"${item.link}\" target=\"_blank\" style=\"text-decoration:none; color:#1a0dab; font-weight:bold; font-size:16px;\">${item.title}</a>\n      <p style=\"margin:8px 0; font-size:14px; color:#333;\">\n        ${item.description} \n        <a href=\"${item.link}\" target=\"_blank\" style=\"color:#555; font-weight:normal;\">Learn more at ${item.source}</a>\n      </p>\n      <span style=\"font-size:12px; color:#999;\">Source: ${item.source} | ${item.date}</span>\n    `;\n    newsContainer.appendChild(card);\n  });\n  displayedCount += nextArticles.length;\n\n  if(displayedCount >= allArticles.length){\n    loadMoreBtn.style.display = 'none';\n  }\n}\n\n// Initial render\nrenderArticles();\n\n// Load more button\nloadMoreBtn.addEventListener('click', renderArticles);\n</script>\n"
    },
