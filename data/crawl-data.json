    {
      "id": "gid://shopify/Page/113292443812",
      "title": "Everything Thrift, in a Jiff!",
      "handle": "banner",
      "body": "<!-- CLEAN HERO BANNER -->\n<section id=\"hero-banner\" class=\"hero-banner\">\n  <div class=\"slides\">\n\n    <!-- Slide 1 -->\n    <div class=\"slide active\" style=\"background-image: url('https://cdn.shopify.com/s/files/1/0648/0701/0468/files/Retro_Thrift_Store_Treasures.png?v=1755486692');\">\n      <div class=\"slide-content\">\n        <div class=\"text-block\">\n          <h1>Discover Amazing Finds in a Jiff!</h1>\n          <p>Shop top products from Collectibles to Customizable Products</p>\n        </div>\n        <div class=\"button-block\"><a href=\"https://enajif.com/collections/all\" class=\"cta-btn\">Shop Now</a></div>\n      </div>\n    </div>\n\n    <!-- Slide 2 -->\n    <div class=\"slide\" style=\"background-image: url('https://cdn.shopify.com/s/files/1/0648/0701/0468/files/Retro_Thrift_Store_Treasures.png?v=1755486692');\">\n      <div class=\"slide-content\">\n        <div class=\"text-block\">\n          <h1>Unbeatable Deals Every Day</h1>\n          <p>Don’t miss our limited-time offers and exclusive drops</p>\n        </div>\n        <div class=\"button-block\"><a href=\"https://enajif.com/collections/all\" class=\"cta-btn\">View Deals</a></div>\n      </div>\n    </div>\n\n    <!-- Slide 3 -->\n    <div class=\"slide\" style=\"background-image: url('https://cdn.shopify.com/s/files/1/0648/0701/0468/files/Retro_Thrift_Store_Treasures.png?v=1755486692');\">\n      <div class=\"slide-content\">\n        <div class=\"text-block\">\n          <h1>Snailbox Surprises Await!</h1>\n          <p>Fun, unique products delivered straight to your door</p>\n        </div>\n        <div class=\"button-block\"><a href=\"https://enajif.com/collections/snailbox-an-enajif-brand\" class=\"cta-btn\">Explore Now</a></div>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- Outside Arrows -->\n  <div class=\"nav-arrows\">\n    <span class=\"prev\">❮</span>\n    <span class=\"next\">❯</span>\n  </div>\n</section>\n\n<style>\n/* Clean thin hero banner */\n#hero-banner.hero-banner {\n  position: relative;\n  overflow: hidden;\n  width: 100%;\n  height: 20vh;\n}\n\n/* Slide base */\n#hero-banner .slides { position: relative; height: 100%; }\n\n#hero-banner .slide {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 20vh;\n  background-size: cover;\n  background-position: center;\n\n  opacity: 0;\n  transform: scale(1.02);\n  transition: opacity 0.9s ease, transform 0.9s ease;\n\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n\n  z-index: 0;\n  pointer-events: none;\n}\n\n/* Dark overlay */\n#hero-banner .slide::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.25);\n  z-index: 0;\n}\n\n#hero-banner .slide.active {\n  opacity: 1;\n  transform: scale(1);\n  z-index: 1;\n  pointer-events: auto;\n}\n\n/* Slide content should be above overlay */\n#hero-banner .slide-content {\n  position: relative;\n  width: 100%;\n  max-width: 1200px;\n  padding: 5px 20px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  background: linear-gradient(to top, rgba(0,0,0,0.25), rgba(0,0,0,0));\n  color: #ffffff; /* white text */\n  z-index: 1;\n}\n\n/* Text styling */\n#hero-banner .text-block h1 {\n  font-size: 1.5rem;\n  margin: 0 0 5px;\n  font-weight: 500;\n  letter-spacing: 0.5px;\n  color: #ffffff;\n  text-shadow: 0 2px 8px rgba(0,0,0,0.5); /* subtle shadow for readability */\n}\n\n#hero-banner .text-block p {\n  font-size: 1rem;\n  margin: 0;\n  color: #ffffff;\n  text-shadow: 0 2px 8px rgba(0,0,0,0.4); /* keep subtle shadow */\n}\n\n/* LOWERED BUTTON */\n#hero-banner .button-block {\n  text-align: right;\n  margin-top: 20px;\n}\n\n/* Button */\n#hero-banner .cta-btn {\n  padding: 10px 25px;\n  font-size: 1rem;\n  background: #ff9900;\n  color: #fff;\n  text-decoration: none;\n  font-weight: bold;\n  border-radius: 6px;\n  transition: background 0.3s;\n}\n\n#hero-banner .cta-btn:hover {\n  background: #e68a00;\n}\n\n/* Arrows */\n#hero-banner .nav-arrows {\n  position: absolute;\n  top: 50%;\n  left: -40px;\n  right: -40px;\n  transform: translateY(-50%);\n  display: flex;\n  justify-content: space-between;\n  pointer-events: none;\n}\n\n#hero-banner .nav-arrows span {\n  pointer-events: auto;\n  cursor: pointer;\n  font-size: 1.8em;\n  opacity: 0.7;\n  color: #fff;\n  transition: 0.2s ease;\n}\n\n#hero-banner .nav-arrows span:hover {\n  opacity: 1;\n  transform: scale(1.1);\n}\n\n/* Mobile adjustments */\n@media (max-width: 768px) {\n  #hero-banner.hero-banner { height: 26vh; }\n  #hero-banner .slide { height: 26vh; }\n  #hero-banner .slide-content { flex-direction: column; text-align: center; }\n  #hero-banner .cta-btn { margin-top: 12px; }\n}\n\n/* AUDIO BELOW BANNER */\n.audio-container {\n  max-width: 100%;\n  width: 100%;\n  margin: 0 auto;\n  text-align: center;\n  padding: 15px 0;\n}\n\n.audio-container audio {\n  width: 100%;\n  border-radius: 12px;\n}\n</style>\n\n<!-- AUDIO BELOW BANNER -->\n<div class=\"audio-container\">\n  <audio controls preload=\"auto\">\n    <source src=\"https://cdn.shopify.com/s/files/1/0648/0701/0468/files/Everything_Thrift_In_a_Jiff.mp3?v=1755487564\" type=\"audio/mpeg\">\n    Your browser does not support the audio element.\n  </source></audio>\n</div>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  const slides = document.querySelectorAll(\"#hero-banner .slide\");\n  const prev = document.querySelector(\"#hero-banner .prev\");\n  const next = document.querySelector(\"#hero-banner .next\");\n\n  let index = 0;\n\n  function showSlide(i) {\n    slides.forEach(slide => slide.classList.remove(\"active\"));\n    slides[i].classList.add(\"active\");\n  }\n\n  function nextSlide() {\n    index = (index + 1) % slides.length;\n    showSlide(index);\n  }\n\n  function prevSlide() {\n    index = (index - 1 + slides.length) % slides.length;\n    showSlide(index);\n  }\n\n  let autoPlay = setInterval(nextSlide, 7000);\n\n  next.addEventListener(\"click\", () => { nextSlide(); clearInterval(autoPlay); });\n  prev.addEventListener(\"click\", () => { prevSlide(); clearInterval(autoPlay); });\n});\n</script>\n"
    },
